# ── Local operating docs ───────────────────────────────────────────────
# Working AI/operating state, kept local by default. Only the root-level files
# below are ignored; durable, shareable docs (README.md, CHANGELOG.md,
# DECISIONS.md, docs/) stay tracked. To version-control these instead, set
# "Operating docs tracking: tracked" in INIT.md and delete this block.
/AGENTS.md
/CLAUDE.md
/CONTEXT.md
/MEMORY.md
/BACKLOGS.md
/WORKLOG.md
/SPEC.md
/REQUIREMENTS.md
/LESSONS.md
# Legacy rootsator files (TODO/HANDOFF/TESTS <=0.5, CHECKLIST <=0.6); keep them local if an older project still has them.
/TODO.md
/HANDOFF.md
/TESTS.md
/CHECKLIST.md
*.local.md

# ── Private material and credentials ────────────────────────────────────
# Containment beats guessing: keep ANYTHING sensitive inside one of these
# ignored directories. Then the rest of the project can be fully git-tracked
# without enumerating secret filenames. Do NOT add broad filename globs such as
# *token* or *secret* or *.key — they also hide normal source (tokenizer.c,
# Keynote .key files, etc.).
*_private/
*_internal/
secrets/

# Environment files are the one common in-place secret; commit a template instead.
.env
.env.*
!.env.example
!.env.sample

# ── Cold planning history and generated output ──────────────────────────
docs/plans/active/*.md
docs/plans/archive/*.md
!docs/plans/active/README.md
!docs/plans/archive/README.md
build/
resources/prep/
resources/cache/

# ── Common local noise ──────────────────────────────────────────────────
.DS_Store
*.tmp
*.log

# ── 저장소에 담지 않는 것: 릴리스 묶음(zip) ─────────────────────────
# zip 은 깃허브 릴리스 자산으로만 배포한다. 저장소에 함께 담으면 판마다
# 23MB 씩 히스토리에 쌓여 Pages 빌드가 느려진다 (2026-08-06 히스토리 재작성).
# 산출물은 저장소가 아니라 릴리스에 붙인다 --- 판마다 45MB 씩 히스토리에 쌓이면
# 저장소가 3.7GB 가 된다(2026-08-16 에 히스토리에서 들어냈다).
/dist/

# ── 공개하지 않는 것: 원고 소스와 그 빌드 도구 ──────────────────────
# 공개 저장소에는 "결과물"(dist/ PDF, docs/ HTML)과 예제 코드만 둔다.
# 원고(Typst)와 조판 스크립트는 저자의 작업 공간에만 있다.
/book/
/book-en/
/scripts/build-book.sh
/scripts/build-book-en.sh
/scripts/build-html.sh
/scripts/wrap-html.py
/scripts/release.sh
/scripts/make-zip.py

# 파이썬 바이트코드 --- 절대 경로가 박혀 있어 공개 저장소에 들어가면 안 된다
__pycache__/
*.pyc

# agy-only customization layer (local; see rootsator RFC-0001)
/.agents/

# ── 예제를 돌리면 나오는 산출물 ────────────────────────────────────
# 각 run.sh 는 끝나며 `make clean` 으로 스스로 지우지만, 중간에 끊기면 남는다.
# greet.o 와 main.o 는 v0.88.0 에 딸려 들어갔고, 그 뒤로 전수 검증을 돌릴 때마다
# 그 예제의 `make clean` 이 *추적되는* 파일을 지워 작업 트리가 더러워졌다
# (2026-09-06). 영어판 트리에는 처음부터 없었다.
examples/**/*.o
examples/**/*.d
examples-en/**/*.o
examples-en/**/*.d
examples/ch102/stale/demo
examples-en/ch102/stale/demo
